---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: 'primary' | 'ghost';
  external?: boolean;
}

const { variant = 'primary', external = false, class: className, ...rest } = Astro.props;
---

<a
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md px-5 py-3 font-mono text-sm transition-colors duration-200',
    variant === 'primary'
      ? 'bg-accent font-bold text-on-accent hover:bg-accent-hover'
      : 'border border-border text-text hover:border-accent hover:text-accent',
    className,
  ]}
  {...rest}
>
  <slot />
  {external && <span aria-hidden="true">↗</span>}
</a>
