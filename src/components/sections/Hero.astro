---
import type { CollectionEntry } from 'astro:content';
import { localize, type Locale } from '../../i18n';
import { formatDecimal, useTranslations } from '../../i18n/ui';
import ButtonLink from '../ui/ButtonLink.astro';
import StatsBar from '../ui/StatsBar.astro';

interface Props {
  locale: Locale;
  profile: CollectionEntry<'profile'>['data'];
  job?: CollectionEntry<'experience'>['data'];
  degree?: CollectionEntry<'education'>['data'];
  technical?: CollectionEntry<'education'>['data'];
}

const { locale, profile, job, degree, technical } = Astro.props;
const t = useTranslations(locale);
const link = (network: string) => profile.profiles.find((p) => p.network === network);
const github = link('GitHub');
const linkedin = link('LinkedIn');
const short = (organization: string) => organization.split(' — ')[0];

type Pair = { key: string; value: string };
const rows = [
  job && { key: t.hero.rows.role, value: `${localize(job.position, locale)} @ ${short(job.organization)}` },
  job && { key: t.hero.rows.mode, value: localize(job.employment, locale) },
  { key: t.hero.rows.focus, value: t.hero.focusValue },
  degree && { key: t.hero.rows.education, value: `${localize(degree.area, locale)} · ${degree.shortName}` },
  technical && {
    key: t.hero.rows.technical,
    value: `${localize(technical.area, locale)} · ${technical.shortName}`,
  },
].filter((row): row is Pair => Boolean(row));

const stats = [
  degree?.score && { value: formatDecimal(degree.score, locale), label: t.stats.gpa },
  { value: t.stats.yearValue, label: t.stats.year },
  job?.startDate && { value: job.startDate.slice(0, 4), label: t.stats.since },
  technical?.endDate && { value: technical.endDate.slice(0, 4), label: t.stats.technical },
].filter((stat): stat is { value: string; label: string } => Boolean(stat));
---

<section aria-labelledby="hero-title" class="relative overflow-hidden border-b border-border">
  <div aria-hidden="true" class="bg-grid bg-grid-fade grid-pan absolute inset-0"></div>
  <div
    aria-hidden="true"
    class="hero-glow pointer-events-none absolute -top-40 left-1/2 size-[44rem] -translate-x-1/2 lg:-right-40 lg:left-auto lg:translate-x-0"
  ></div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-6 pt-16 pb-14 md:pt-24 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16 lg:pb-20">
    <div>
      <p class="font-mono text-sm text-accent">
        <span aria-hidden="true">&gt; </span>
        <span class="type-in" style={`--chars: ${t.hero.prompt.length}`}>
          {t.hero.prompt}
        </span>
      </p>
      <h1
        id="hero-title"
        class="mt-4 animate-fade-up text-display font-bold tracking-tight [animation-delay:150ms]"
      >
        {profile.name}
      </h1>
      <p class="mt-4 animate-fade-up font-mono text-base text-accent [animation-delay:250ms] md:text-lg">
        {localize(profile.label, locale)}
      </p>
      <p class="mt-6 max-w-[56ch] animate-fade-up text-lg text-text-muted [animation-delay:350ms]">
        {t.hero.pitch}
      </p>
      <div class="mt-8 flex animate-fade-up flex-wrap gap-3 [animation-delay:450ms]">
        <ButtonLink href={`mailto:${profile.email}`}>{t.hero.ctaEmail}</ButtonLink>
        {github && (
          <ButtonLink href={github.url} variant="ghost" external rel="me">
            GitHub
          </ButtonLink>
        )}
        {linkedin && (
          <ButtonLink href={linkedin.url} variant="ghost" external rel="me">
            LinkedIn
          </ButtonLink>
        )}
      </div>
    </div>

    <div class="animate-fade-up [animation-delay:400ms]">
      <div class="card-glow rounded-lg border border-border bg-surface/90 font-mono text-sm shadow-2xl backdrop-blur-sm">
        <div class="flex items-center gap-2 border-b border-border px-4 py-3" aria-hidden="true">
          <span class="size-3 rounded-full bg-accent"></span>
          <span class="size-3 rounded-full bg-border"></span>
          <span class="size-3 rounded-full bg-border"></span>
          <span class="ml-3 text-xs text-text-muted">{t.hero.terminalTitle}</span>
        </div>
        <div class="p-5">
          <p class="text-text-muted">
            <span class="mr-2 text-accent" aria-hidden="true">
              $
            </span>
            {t.hero.command}
          </p>
          <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-2.5">
            {rows.map((row, i) => (
              <>
                <dt class="animate-fade-up text-accent" style={`animation-delay: ${700 + i * 140}ms`}>
                  {row.key}
                </dt>
                <dd class="animate-fade-up text-text" style={`animation-delay: ${740 + i * 140}ms`}>
                  {row.value}
                </dd>
              </>
            ))}
          </dl>
          <p class="mt-4" aria-hidden="true">
            <span class="text-accent">$</span>
            <span class="inline-block h-4 w-2 translate-y-0.5 animate-blink bg-accent"></span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <StatsBar stats={stats} />
</section>
