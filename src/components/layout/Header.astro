---
import { homePath, htmlLang, otherLocale, playPath, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  page: 'pro' | 'play';
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);
const paths = page === 'pro' ? homePath : playPath;
const sections =
  page === 'pro'
    ? (['about', 'experience', 'projects', 'skills', 'contact'] as const)
    : (['games', 'sheet', 'tabletop', 'contact'] as const);
const cross =
  page === 'pro'
    ? { href: playPath[locale], label: t.nav.toPlay, icon: '◆' }
    : { href: homePath[locale], label: t.nav.toPro, icon: '←' };
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-6">
    <a href={homePath[locale]} class="group font-mono text-sm font-bold transition-colors hover:text-accent">
      <span class="mr-1 text-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">
        &gt;_
      </span>
      pedro.caurio
    </a>
    <nav aria-label={t.nav.label} class="hidden lg:block">
      <ul class="flex gap-6 font-mono text-sm text-text-muted">
        {sections.map((section) => (
          <li>
            <a
              href={`#${section}`}
              class="relative py-1 transition-colors duration-200 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-200 hover:text-accent hover:after:scale-x-100"
            >
              {t.nav[section]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={cross.href}
        class="group inline-flex items-center gap-2 rounded-sm border border-accent/50 px-2.5 py-1 font-mono text-xs text-accent transition-colors duration-200 hover:bg-accent hover:text-on-accent"
      >
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:rotate-45">
          {cross.icon}
        </span>
        {cross.label}
      </a>
      <a
        href={paths[other]}
        hreflang={htmlLang[other]}
        lang={htmlLang[other]}
        aria-label={`${t.lang.switchTo} — ${t.lang.switchLabel}`}
        class="rounded-sm border border-border px-2.5 py-1 font-mono text-xs transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        {t.lang.switchTo}
      </a>
    </div>
  </div>
  <div aria-hidden="true" class="scroll-progress absolute inset-x-0 -bottom-px h-0.5 bg-accent"></div>
</header>
