---
interface Props {
  stats: { value: string; label: string }[];
}

const { stats } = Astro.props;
---

<div class="relative border-t border-border bg-surface/60">
  <dl class="mx-auto grid max-w-6xl grid-cols-2 px-6 md:grid-cols-4">
    {stats.map((stat, i) => (
      <div
        class:list={[
          'group flex animate-fade-up flex-col-reverse justify-end gap-1 py-6',
          i % 2 === 1 && 'pl-6 max-md:border-l max-md:border-border',
          i > 0 && 'md:border-l md:border-border md:pl-6',
          i > 1 && 'max-md:border-t max-md:border-border',
        ]}
        style={`animation-delay: ${500 + i * 110}ms`}
      >
        <dt class="text-sm text-text-muted">{stat.label}</dt>
        <dd class="font-mono text-3xl font-bold text-text transition-colors duration-200 group-hover:text-accent">
          {stat.value}
        </dd>
      </div>
    ))}
  </dl>
</div>
