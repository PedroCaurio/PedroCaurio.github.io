---
import type { CollectionEntry } from 'astro:content';
import { localize, type Locale } from '../../i18n';
import { formatYearMonth, useTranslations } from '../../i18n/ui';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  locale: Locale;
  experience: CollectionEntry<'experience'>['data'][];
}

const { locale, experience } = Astro.props;
const t = useTranslations(locale);
const period = (job: Props['experience'][number]) => {
  if (!job.startDate) return undefined;
  const end = job.endDate ? formatYearMonth(job.endDate, locale) : t.experience.present;
  return `${formatYearMonth(job.startDate, locale)} — ${end}`;
};
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="scroll-mt-16 border-t border-border bg-surface py-20 md:py-28"
>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      id="experience-title"
      index="02"
      eyebrow={t.experience.eyebrow}
      title={t.experience.title}
    />
    <ol class="space-y-6">
      {experience.map((job) => (
        <li class="grid gap-6 rounded-lg border border-border bg-card p-6 md:grid-cols-[12rem_1fr] md:gap-10 md:p-8">
          <div class="font-mono text-sm">
            {period(job) && <p class="text-accent">{period(job)}</p>}
            <p class="mt-1 text-text-muted">{localize(job.employment, locale)}</p>
            {job.confidential && (
              <p class="mt-4">
                <Tag variant="accent">{t.experience.confidential}</Tag>
              </p>
            )}
          </div>
          <div>
            <h3 class="text-xl font-bold">{localize(job.position, locale)}</h3>
            <p class="mt-1 text-text-muted">
              {job.url ? (
                <a
                  href={job.url}
                  class="underline-offset-4 transition-colors hover:text-accent hover:underline"
                >
                  {job.organization} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                job.organization
              )}
            </p>
            <p class="mt-4 max-w-[68ch]">{localize(job.summary, locale)}</p>
            <ul class="mt-5 space-y-2">
              {localize(job.highlights, locale).map((highlight) => (
                <li class="flex gap-3 text-text-muted">
                  <span class="font-mono text-accent" aria-hidden="true">
                    ▹
                  </span>
                  <span>{highlight}</span>
                </li>
              ))}
            </ul>
            {job.tags.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {job.tags.map((tag) => (
                  <li>
                    <Tag>{tag}</Tag>
                  </li>
                ))}
              </ul>
            )}
            {job.confidential && <p class="mt-6 text-sm text-text-muted">{t.experience.confidentialNote}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
