---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { gamePath, localize, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import { gameCover } from '../../lib/covers';
import Tag from '../ui/Tag.astro';

interface Props {
  locale: Locale;
  game: CollectionEntry<'games'>;
  size: 'featured' | 'compact';
}

const { locale, game, size } = Astro.props;
const t = useTranslations(locale);
const { data } = game;
const cover = gameCover(game.id);
const featured = size === 'featured';
const contributions = localize(data.contributions, locale);
---

<article
  data-kind="game"
  data-game={game.id}
  class="card-glow group flex h-full flex-col rounded-lg border border-border bg-card"
>
  {cover && (
    <div
      class="relative aspect-video overflow-hidden rounded-t-lg border-b border-border bg-surface"
      style={featured ? `view-transition-name: game-cover-${game.id}` : undefined}
    >
      <Image
        src={cover}
        alt={`${t.games.coverAlt} ${data.title}`}
        widths={featured ? [480, 800, 1200] : [400, 640]}
        sizes={
          featured
            ? '(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw'
            : '(min-width: 1024px) 280px, (min-width: 768px) 50vw, 100vw'
        }
        class:list={[
          'size-full transition-transform duration-500 ease-out-soft group-hover:scale-[1.06]',
          data.coverFit === 'contain' ? 'object-contain p-4' : 'object-cover',
        ]}
        loading="lazy"
      />
      <div
        aria-hidden="true"
        class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
      >
        <div class="scanlines flicker size-full"></div>
      </div>
    </div>
  )}
  <div class:list={['flex flex-1 flex-col', featured ? 'p-6' : 'p-5']}>
    <p class="font-mono text-xs text-accent">
      {data.engine} · {localize(data.genre, locale)}
    </p>
    <h3 class:list={['mt-2 font-bold', featured ? 'text-xl' : 'text-lg']}>
      {featured ? (
        <a href={gamePath(locale, game.id)} class="stretched-link transition-colors group-hover:text-accent">
          {data.title}
        </a>
      ) : (
        data.title
      )}
    </h3>

    {featured && data.jam?.awards && (
      <ul class="mt-3 flex flex-wrap gap-2" aria-label={data.jam.name}>
        {localize(data.jam.awards, locale).map((award) => (
          <li>
            <Tag variant="accent" class="shimmer">
              {award}
            </Tag>
          </li>
        ))}
      </ul>
    )}

    {featured && <p class="mt-3 text-sm text-text-muted">{localize(data.summary, locale)}</p>}

    <ul class:list={['space-y-1.5 text-sm', featured ? 'mt-4' : 'mt-3']}>
      {(featured ? contributions : contributions.slice(0, 2)).map((item) => (
        <li class="flex gap-2.5">
          <span class="font-mono text-accent" aria-hidden="true">
            ▹
          </span>
          <span>{item}</span>
        </li>
      ))}
    </ul>

    {featured && data.team.length > 1 && (
      <p class="mt-4 text-xs text-text-muted">
        <span class="font-mono text-text">{t.games.team}:</span>{' '}
        {data.team.map((member) => member.name).join(', ')}
      </p>
    )}

    <div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-5 font-mono text-sm">
      {featured && (
        <span class="text-text transition-colors group-hover:text-accent" aria-hidden="true">
          {t.games.details}
          <span class="ml-1 inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
        </span>
      )}
      <a href={data.links.itch} class="relative z-10 text-accent underline-offset-4 hover:underline">
        {t.games.itch} <span aria-hidden="true">↗</span>
        <span class="sr-only"> — {data.title}</span>
      </a>
      {data.links.repo && (
        <a href={data.links.repo} class="relative z-10 text-accent underline-offset-4 hover:underline">
          {t.games.repo} <span aria-hidden="true">↗</span>
          <span class="sr-only"> — {data.title}</span>
        </a>
      )}
      {data.noGenerativeAi && <span class="text-xs text-text-muted">{t.games.noAi}</span>}
      {data.playableInBrowser && <span class="text-xs text-text-muted">{t.games.browser}</span>}
    </div>
  </div>
</article>
