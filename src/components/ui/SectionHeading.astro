---
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

const { id, index, eyebrow, title, intro } = Astro.props;
---

<header class="reveal mb-10 max-w-2xl md:mb-14">
  <p class="font-mono text-sm text-accent" aria-hidden="true">
    {index} // {eyebrow}
  </p>
  <h2 id={id} class="heading-bar mt-3 text-3xl font-bold tracking-tight">
    {title}
  </h2>
  {intro && <p class="mt-5 text-lg text-text-muted">{intro}</p>}
</header>
