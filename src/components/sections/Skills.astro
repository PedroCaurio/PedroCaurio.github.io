---
import type { CollectionEntry } from 'astro:content';
import { localize, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  locale: Locale;
  skills: CollectionEntry<'skills'>['data'][];
  variant: 'pro' | 'sheet';
  index: string;
}

const { locale, skills, variant, index } = Astro.props;
const t = useTranslations(locale);
const sheet = variant === 'sheet';
const id = sheet ? 'sheet' : 'skills';
const copy = sheet ? t.sheet : t.skills;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={['border-t border-border py-20 md:py-28', sheet && 'bg-surface']}
>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      id={`${id}-title`}
      index={index}
      eyebrow={copy.eyebrow}
      title={copy.title}
      intro={copy.intro}
    />
    {sheet && (
      <dl class="reveal mb-8 flex flex-wrap gap-x-10 gap-y-3 font-mono text-sm">
        <div class="flex gap-2">
          <dt class="text-text-muted">{t.sheet.classLabel}:</dt>
          <dd>{t.sheet.classValue}</dd>
        </div>
        <div class="flex gap-2">
          <dt class="text-text-muted">{t.sheet.backgroundLabel}:</dt>
          <dd>{t.sheet.backgroundValue}</dd>
        </div>
      </dl>
    )}
    <ul class:list={['grid gap-5 sm:grid-cols-2', sheet ? 'lg:grid-cols-3' : 'lg:grid-cols-4']}>
      {skills.map((group, i) => (
        <li class="reveal">
          <div class="card-glow group h-full rounded-lg border border-border bg-card p-6">
            <div class="flex items-baseline gap-4">
              {sheet ? (
                <span
                  class="font-mono text-3xl font-bold text-accent transition-transform duration-300 group-hover:scale-110"
                  aria-hidden="true"
                >
                  {localize(group.attribute, locale)}
                </span>
              ) : (
                <span class="font-mono text-xs text-accent" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              )}
              <h3 class="text-lg font-bold">{localize(group.name, locale)}</h3>
            </div>
            <ul class="mt-5 flex flex-wrap gap-2">
              {localize(group.keywords, locale).map((keyword) => (
                <li>
                  <Tag>{keyword}</Tag>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
