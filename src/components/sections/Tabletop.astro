---
import type { CollectionEntry } from 'astro:content';
import { localize, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  locale: Locale;
  systems: CollectionEntry<'rpg'>['data'][];
  masterYears: number;
}

const { locale, systems, masterYears } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="tabletop"
  aria-labelledby="tabletop-title"
  class="scroll-mt-16 border-t border-border bg-surface py-20 md:py-28"
>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading id="tabletop-title" index="06" eyebrow={t.tabletop.eyebrow} title={t.tabletop.title} />
    <ul class="grid gap-6 md:grid-cols-2">
      {systems.map((system) => (
        <li class="rounded-lg border border-border bg-card p-6 md:p-8">
          <p class="flex flex-wrap items-center gap-3 font-mono text-xs text-text-muted">
            {t.tabletop.system}
            <Tag variant="accent">{localize(system.status, locale)}</Tag>
          </p>
          <h3 class="mt-3 text-2xl font-bold">{system.title}</h3>
          {system.summary && <p class="mt-3 text-text-muted">{localize(system.summary, locale)}</p>}
        </li>
      ))}
      <li class="rounded-lg border border-border bg-card p-6 md:p-8">
        <div class="flex items-baseline gap-4">
          <span class="font-mono text-3xl font-bold text-accent" aria-hidden="true">
            {masterYears}+
          </span>
          <h3 class="text-2xl font-bold">{t.tabletop.masterTitle}</h3>
        </div>
        <p class="mt-3 text-text-muted">{t.tabletop.masterText(masterYears)}</p>
      </li>
    </ul>
  </div>
</section>
