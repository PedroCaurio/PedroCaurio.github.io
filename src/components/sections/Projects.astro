---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  locale: Locale;
  projects: CollectionEntry<'projects'>['data'][];
  githubUrl?: string;
}

const { locale, projects, githubUrl } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="projects"
  aria-labelledby="projects-title"
  class="scroll-mt-16 border-t border-border py-20 md:py-28"
>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading id="projects-title" index="03" eyebrow={t.projects.eyebrow} title={t.projects.title} />
    <ul class="grid gap-6 lg:grid-cols-3">
      {projects.map((project) => (
        <li class="reveal lg:col-span-2">
          <article class="card-glow flex h-full flex-col rounded-lg border border-border bg-card p-6 md:p-8">
            <h3 class="text-xl font-bold">{project.title}</h3>
            <p class="mt-3 max-w-[64ch] text-text-muted">{project.summary}</p>
            <p class="mt-4 text-sm">
              <span class="font-mono text-accent">{t.projects.role}:</span> {project.role}
            </p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {project.stack.map((tech) => (
                <li>
                  <Tag>{tech}</Tag>
                </li>
              ))}
            </ul>
            <p class="mt-auto flex flex-wrap gap-5 pt-6 font-mono text-sm">
              {project.links.repo && (
                <a href={project.links.repo} class="text-accent underline-offset-4 hover:underline">
                  {t.projects.repo} <span aria-hidden="true">↗</span>
                  <span class="sr-only"> — {project.title}</span>
                </a>
              )}
              {project.links.demo && (
                <a href={project.links.demo} class="text-accent underline-offset-4 hover:underline">
                  {t.projects.demo} <span aria-hidden="true">↗</span>
                  <span class="sr-only"> — {project.title}</span>
                </a>
              )}
            </p>
          </article>
        </li>
      ))}
      {githubUrl && (
        <li class="reveal flex flex-col rounded-lg border border-dashed border-border p-6 transition-colors duration-200 hover:border-accent/60 md:p-8">
          <h3 class="font-mono text-lg font-bold">{t.projects.githubTitle}</h3>
          <p class="mt-3 text-text-muted">{t.projects.githubText}</p>
          <a
            href={githubUrl}
            class="mt-auto pt-6 font-mono text-sm text-accent underline-offset-4 hover:underline"
          >
            {t.projects.githubCta} <span aria-hidden="true">↗</span>
          </a>
        </li>
      )}
    </ul>
  </div>
</section>
