---
import type { Locale } from '../../i18n';
import { playPath } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import ButtonLink from '../ui/ButtonLink.astro';
import D20 from '../ui/D20.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section aria-labelledby="teaser-title" class="border-t border-border py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-6">
    <div class="reveal">
      <div class="card-glow group relative overflow-hidden rounded-lg border border-border bg-card p-8 md:p-12">
        <div aria-hidden="true" class="bg-grid grid-pan absolute inset-0 opacity-60"></div>
        <div aria-hidden="true" class="scanlines absolute inset-0 opacity-40"></div>
        <D20 class="float pointer-events-none absolute -right-6 -bottom-10 size-48 text-accent/25 transition-colors duration-300 group-hover:text-accent/50 md:right-10 md:size-56" />
        <div class="relative max-w-xl">
          <p class="font-mono text-sm text-accent" aria-hidden="true">
            // {t.teaser.eyebrow}
          </p>
          <h2 id="teaser-title" class="mt-3 text-3xl font-bold tracking-tight">
            {t.teaser.title}
          </h2>
          <p class="mt-4 text-lg text-text-muted">{t.teaser.text}</p>
          <ButtonLink href={playPath[locale]} class="group/cta mt-8">
            {t.teaser.cta}
            <span aria-hidden="true" class="transition-transform duration-200 group-hover/cta:translate-x-1">
              →
            </span>
          </ButtonLink>
        </div>
      </div>
    </div>
  </div>
</section>
