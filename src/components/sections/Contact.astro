---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import ButtonLink from '../ui/ButtonLink.astro';

interface Props {
  locale: Locale;
  profile: CollectionEntry<'profile'>['data'];
}

const { locale, profile } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="relative scroll-mt-16 overflow-hidden border-t border-border py-24 md:py-32"
>
  <div aria-hidden="true" class="bg-grid bg-grid-fade absolute inset-0"></div>
  <div class="relative mx-auto max-w-3xl px-6 text-center">
    <p class="font-mono text-sm text-accent" aria-hidden="true">
      07 // {t.contact.eyebrow}
    </p>
    <h2 id="contact-title" class="mt-3 text-display font-bold tracking-tight">
      {t.contact.title}
    </h2>
    <p class="mx-auto mt-6 max-w-[52ch] text-lg text-text-muted">{t.contact.text}</p>
    <div class="mt-10 flex justify-center">
      <ButtonLink href={`mailto:${profile.email}`} class="px-6 py-4 text-base break-all">
        {profile.email}
      </ButtonLink>
    </div>
    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {profile.profiles.map((p) => (
        <li>
          <ButtonLink href={p.url} variant="ghost" external rel="me">
            {p.network}
          </ButtonLink>
        </li>
      ))}
    </ul>
  </div>
</section>
