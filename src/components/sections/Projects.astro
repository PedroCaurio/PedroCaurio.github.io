---
import type { CollectionEntry } from 'astro:content';
import { projectPath, projectSlug, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  locale: Locale;
  projects: CollectionEntry<'projects'>[];
  githubUrl?: string;
}

const { locale, projects, githubUrl } = Astro.props;
const t = useTranslations(locale);
---

<section id="projects" aria-labelledby="projects-title" class="border-t border-border py-20 md:py-28">
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      id="projects-title"
      index="03"
      eyebrow={t.projects.eyebrow}
      title={t.projects.title}
      intro={t.projects.intro}
    />
    <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {projects.map(({ id, data }, i) => {
        const slug = projectSlug(id);
        const featured = data.featured;
        return (
          <li
            class:list={[
              'reveal',
              featured ? 'md:col-span-2 lg:col-span-3' : 'md:last:col-span-2 lg:last:col-span-1',
            ]}
            style={`--reveal-offset: ${featured ? 0 : ((i - 1) % 3) * 12}%`}
          >
            <article
              class:list={[
                'card-glow group flex h-full flex-col rounded-lg border border-border bg-card p-6 md:p-8',
                featured && 'lg:grid lg:grid-cols-[1.4fr_1fr] lg:gap-x-12',
              ]}
            >
              <div class="flex flex-col">
                <p class="font-mono text-xs text-accent">
                  {data.context}
                  {data.team.length > 1 && <span class="text-text-muted"> · {t.projects.team}</span>}
                </p>
                <h3 class:list={['mt-2 font-bold', featured ? 'text-2xl md:text-3xl' : 'text-xl']}>
                  <a href={projectPath(locale, slug)} class="stretched-link">
                    <span class="inline-block" style={`view-transition-name: project-${slug}`}>
                      {data.title}
                    </span>
                  </a>
                </h3>
                <p class="mt-3 max-w-[64ch] text-text-muted">{data.summary}</p>
                <p class="mt-4 text-sm">
                  <span class="font-mono text-accent">{t.projects.role}:</span> {data.role}
                </p>
              </div>

              <div class:list={['flex flex-col', featured && 'lg:border-l lg:border-border lg:pl-12']}>
                {featured && data.facts.length > 0 && (
                  <dl class="mt-6 grid grid-cols-3 gap-4 lg:mt-0 lg:grid-cols-1">
                    {data.facts.map((fact) => (
                      <div class="flex flex-col-reverse">
                        <dt class="mt-1 font-mono text-xs text-text-muted">{fact.label}</dt>
                        <dd class="font-bold text-text">{fact.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}
                <ul class="mt-5 flex flex-wrap gap-2">
                  {data.stack.slice(0, featured ? undefined : 5).map((tech) => (
                    <li>
                      <Tag>{tech}</Tag>
                    </li>
                  ))}
                </ul>
                <p class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-2 pt-6 font-mono text-sm">
                  <span class="text-text transition-colors group-hover:text-accent" aria-hidden="true">
                    {t.projects.read}
                    <span class="ml-1 inline-block transition-transform duration-200 group-hover:translate-x-1">
                      →
                    </span>
                  </span>
                  {data.links.repo && (
                    <a
                      href={data.links.repo}
                      class="relative z-10 text-accent underline-offset-4 hover:underline"
                    >
                      {t.projects.repo} <span aria-hidden="true">↗</span>
                      <span class="sr-only"> — {data.title}</span>
                    </a>
                  )}
                  {data.links.demo && (
                    <a
                      href={data.links.demo}
                      class="relative z-10 text-accent underline-offset-4 hover:underline"
                    >
                      {t.projects.demo} <span aria-hidden="true">↗</span>
                      <span class="sr-only"> — {data.title}</span>
                    </a>
                  )}
                </p>
              </div>
            </article>
          </li>
        );
      })}
    </ul>
    {githubUrl && (
      <p class="reveal mt-10 flex flex-col gap-2 rounded-lg border border-dashed border-border p-6 transition-colors duration-200 hover:border-accent/60 sm:flex-row sm:items-center sm:justify-between">
        <span>
          <span class="font-mono font-bold">{t.projects.githubTitle}.</span>{' '}
          <span class="text-text-muted">{t.projects.githubText}</span>
        </span>
        <a href={githubUrl} class="shrink-0 font-mono text-sm text-accent underline-offset-4 hover:underline">
          {t.projects.githubCta} <span aria-hidden="true">↗</span>
        </a>
      </p>
    )}
  </div>
</section>
