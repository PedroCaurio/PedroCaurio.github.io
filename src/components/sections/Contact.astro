---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import ButtonLink from '../ui/ButtonLink.astro';

interface Props {
  locale: Locale;
  profile: CollectionEntry<'profile'>['data'];
  index: string;
}

const { locale, profile, index } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="relative overflow-hidden border-t border-border py-24 md:py-32"
>
  <div aria-hidden="true" class="bg-grid bg-grid-fade grid-pan absolute inset-0"></div>
  <div
    aria-hidden="true"
    class="hero-glow pointer-events-none absolute top-1/2 left-1/2 size-[36rem] -translate-1/2"
  ></div>
  <div class="reveal relative mx-auto max-w-3xl px-6 text-center">
    <p class="font-mono text-sm text-accent" aria-hidden="true">
      {index} // {t.contact.eyebrow}
    </p>
    <h2 id="contact-title" class="mt-3 text-display font-bold tracking-tight">
      {t.contact.title}
    </h2>
    <p class="mx-auto mt-6 max-w-[52ch] text-lg text-text-muted">{t.contact.text}</p>
    <div class="mt-10 flex justify-center">
      <ButtonLink
        href={`mailto:${profile.email}`}
        class="px-6 py-4 text-base break-all shadow-glow transition-shadow hover:shadow-[0_0_0_1px_var(--color-accent),0_0_40px_-6px_var(--color-accent)]"
      >
        {profile.email}
      </ButtonLink>
    </div>
    <ul class="mt-8 flex flex-wrap justify-center gap-3">
      {profile.profiles.map((p) => (
        <li>
          <ButtonLink href={p.url} variant="ghost" external rel="me">
            {p.network}
          </ButtonLink>
        </li>
      ))}
    </ul>
  </div>
</section>
