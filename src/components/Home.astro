---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './layout/Header.astro';
import Footer from './layout/Footer.astro';
import Hero from './sections/Hero.astro';
import About from './sections/About.astro';
import Experience from './sections/Experience.astro';
import Projects from './sections/Projects.astro';
import Skills from './sections/Skills.astro';
import PlayTeaser from './sections/PlayTeaser.astro';
import Contact from './sections/Contact.astro';
import Marquee from './ui/Marquee.astro';
import { contentKey, homePath, localize, locales, type Locale } from '../i18n';
import { useTranslations } from '../i18n/ui';
import { personJsonLd } from '../lib/jsonld';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const byOrder = <T extends { data: { order: number } }>(a: T, b: T) => a.data.order - b.data.order;

const [profileEntry] = await getCollection('profile');
const profile = profileEntry.data;
const experience = (await getCollection('experience')).sort(byOrder).map((entry) => entry.data);
const education = (await getCollection('education')).sort(byOrder).map((entry) => entry.data);
const skills = (await getCollection('skills')).sort(byOrder).map((entry) => entry.data);
const proSkills = skills.filter((group) => group.track === 'professional');
const projects = (
  await getCollection(
    'projects',
    ({ id, data }) => id.startsWith(`${contentKey(locale)}/`) && !data.draft && !data.confidential,
  )
)
  .sort(byOrder)
  .map((entry) => entry.data);

const degree = education.find((ed) => ed.expected);
const technical = education.find((ed) => !ed.expected);
const github = profile.profiles.find((p) => p.network === 'GitHub');
const jsonLd = personJsonLd({ site: Astro.site!, locale, profile, experience, education, skills });
---

<BaseLayout
  title={t.meta.title}
  description={t.meta.description}
  locale={locale}
  alternates={locales.map((l) => ({ locale: l, href: homePath[l] }))}
  jsonLd={jsonLd}
>
  <Header slot="header" locale={locale} page="pro" />
  <Hero
    locale={locale}
    profile={profile}
    job={experience.find((job) => !job.endDate)}
    degree={degree}
    technical={technical}
  />
  <Marquee items={proSkills.flatMap((group) => localize(group.keywords, locale))} />
  <About locale={locale} profile={profile} education={education} />
  <Experience locale={locale} experience={experience} />
  <Projects locale={locale} projects={projects} githubUrl={github?.url} />
  <Skills locale={locale} skills={proSkills} variant="pro" index="04" />
  <PlayTeaser locale={locale} />
  <Contact locale={locale} profile={profile} index="05" />
  <Footer slot="footer" locale={locale} name={profile.name} />
</BaseLayout>
