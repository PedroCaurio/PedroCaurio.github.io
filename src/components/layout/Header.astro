---
import { homePath, htmlLang, otherLocale, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);
const sections = ['about', 'experience', 'projects', 'games', 'skills', 'contact'] as const;
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-6 px-6">
    <a href={homePath[locale]} class="font-mono text-sm font-bold transition-colors hover:text-accent">
      <span class="text-accent" aria-hidden="true">
        &gt;_
      </span>{' '}
      pedro.caurio
    </a>
    <nav aria-label={t.nav.label} class="hidden md:block">
      <ul class="flex gap-6 font-mono text-sm text-text-muted">
        {sections.map((section) => (
          <li>
            <a href={`#${section}`} class="transition-colors duration-200 hover:text-accent">
              {t.nav[section]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a
      href={homePath[other]}
      hreflang={htmlLang[other]}
      lang={htmlLang[other]}
      aria-label={`${t.lang.switchTo} — ${t.lang.switchLabel}`}
      class="rounded-sm border border-border px-2.5 py-1 font-mono text-xs transition-colors duration-200 hover:border-accent hover:text-accent"
    >
      {t.lang.switchTo}
    </a>
  </div>
</header>
