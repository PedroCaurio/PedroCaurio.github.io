---
import type { Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  name: string;
}

const { locale, name } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex max-w-6xl flex-col gap-3 px-6 py-8 font-mono text-xs text-text-muted md:flex-row md:items-center md:justify-between">
    <p>
      © {year} {name}. {t.footer.builtWith}
    </p>
    <a
      href="https://github.com/PedroCaurio/PedroCaurio.github.io"
      class="transition-colors duration-200 hover:text-accent"
    >
      {t.footer.source} <span aria-hidden="true">↗</span>
    </a>
  </div>
</footer>
