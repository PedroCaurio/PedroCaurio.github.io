---
import type { CollectionEntry } from 'astro:content';
import { localize, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';
import SectionHeading from '../ui/SectionHeading.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  locale: Locale;
  skills: CollectionEntry<'skills'>['data'][];
}

const { locale, skills } = Astro.props;
const t = useTranslations(locale);
---

<section
  id="skills"
  aria-labelledby="skills-title"
  class="scroll-mt-16 border-t border-border py-20 md:py-28"
>
  <div class="mx-auto max-w-6xl px-6">
    <SectionHeading
      id="skills-title"
      index="05"
      eyebrow={t.skills.eyebrow}
      title={t.skills.title}
      intro={t.skills.intro}
    />
    <dl class="mb-8 flex flex-wrap gap-x-10 gap-y-3 font-mono text-sm">
      <div class="flex gap-2">
        <dt class="text-text-muted">{t.skills.classLabel}:</dt>
        <dd>{t.skills.classValue}</dd>
      </div>
      <div class="flex gap-2">
        <dt class="text-text-muted">{t.skills.backgroundLabel}:</dt>
        <dd>{t.skills.backgroundValue}</dd>
      </div>
    </dl>
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {skills.map((group) => (
        <li class="rounded-lg border border-border bg-card p-6 transition-colors duration-200 hover:border-accent/60">
          <div class="flex items-baseline gap-4">
            <span class="font-mono text-3xl font-bold text-accent" aria-hidden="true">
              {localize(group.attribute, locale)}
            </span>
            <h3 class="text-lg font-bold">{localize(group.name, locale)}</h3>
          </div>
          <ul class="mt-5 flex flex-wrap gap-2">
            {group.keywords.map((keyword) => (
              <li>
                <Tag>{keyword}</Tag>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </div>
</section>
