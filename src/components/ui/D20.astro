---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 100 100"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
>
  <polygon points="50,4 90,27 90,73 50,96 10,73 10,27"></polygon>
  <polygon points="50,24 76,68 24,68"></polygon>
  <path d="M50 4 L50 24 M90 27 L76 68 M10 27 L24 68 M50 96 L24 68 M50 96 L76 68 M90 73 L76 68 M10 73 L24 68 M90 27 L50 24 M10 27 L50 24"></path>
  <text
    x="50"
    y="56"
    text-anchor="middle"
    font-size="16"
    font-family="var(--font-mono)"
    fill="currentColor"
    stroke="none"
  >
    20
  </text>
</svg>
