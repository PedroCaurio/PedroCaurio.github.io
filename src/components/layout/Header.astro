---
import { homePath, htmlLang, otherLocale, playPath, type Locale } from '../../i18n';
import { useTranslations } from '../../i18n/ui';

interface Props {
  locale: Locale;
  page: 'pro' | 'play';
  /** Prefix for section anchors; set on subpages so `#about` points back to the main page. */
  sectionBase?: string;
  /** Same page in the other language; defaults to the main page of the track. */
  alternate?: string;
}

const { locale, page, sectionBase = '', alternate } = Astro.props;
const t = useTranslations(locale);
const other = otherLocale(locale);
const paths = page === 'pro' ? homePath : playPath;
const sections =
  page === 'pro'
    ? (['about', 'experience', 'projects', 'process', 'skills', 'contact'] as const)
    : (['games', 'sheet', 'tabletop', 'contact'] as const);
const cross =
  page === 'pro'
    ? { href: playPath[locale], label: t.nav.toPlay, icon: '◆' }
    : { href: homePath[locale], label: t.nav.toPro, icon: '←' };
---

<header class="sticky top-0 z-40 border-b border-border bg-bg/85 backdrop-blur-md [view-transition-name:site-header]">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 px-4 sm:px-6 xl:h-16 xl:flex-nowrap">
    <a
      href={homePath[locale]}
      class="group flex h-14 items-center font-mono text-sm font-bold transition-colors hover:text-accent xl:h-auto"
    >
      <span class="mr-1 text-accent transition-transform group-hover:translate-x-0.5" aria-hidden="true">
        &gt;_
      </span>
      pedro.caurio
    </a>
    <nav
      aria-label={t.nav.label}
      class="nav-scroll order-last -mx-4 w-[calc(100%+2rem)] overflow-x-auto border-t border-border/60 sm:-mx-6 sm:w-[calc(100%+3rem)] xl:order-none xl:mx-0 xl:w-auto xl:overflow-visible xl:border-0"
    >
      <ul class="flex w-max gap-5 px-4 py-2.5 font-mono text-sm text-text-muted sm:px-6 xl:gap-6 xl:p-0">
        {sections.map((section) => (
          <li>
            <a
              href={`${sectionBase}#${section}`}
              class="relative inline-block py-1 whitespace-nowrap transition-colors duration-200 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-200 hover:text-accent hover:after:scale-x-100"
            >
              {t.nav[section]}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={cross.href}
        class="group inline-flex items-center gap-2 rounded-sm border border-accent/50 px-2.5 py-1 font-mono text-xs whitespace-nowrap text-accent transition-colors duration-200 hover:bg-accent hover:text-on-accent"
      >
        <span aria-hidden="true" class="transition-transform duration-200 group-hover:rotate-45">
          {cross.icon}
        </span>
        {cross.label}
      </a>
      <a
        href={alternate ?? paths[other]}
        hreflang={htmlLang[other]}
        lang={htmlLang[other]}
        aria-label={`${t.lang.switchTo} — ${t.lang.switchLabel}`}
        class="rounded-sm border border-border px-2.5 py-1 font-mono text-xs transition-colors duration-200 hover:border-accent hover:text-accent"
      >
        {t.lang.switchTo}
      </a>
    </div>
  </div>
  <div aria-hidden="true" class="scroll-progress absolute inset-x-0 -bottom-px h-0.5 bg-accent"></div>
</header>
